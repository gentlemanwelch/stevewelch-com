# Copy to .env.local for local development, and set the same values in the
# Vercel project settings for production.
#
# Nothing here is a secret in this file — it is the list of names, not values.
# Never commit a real key: git history is permanent.

# Resend API key, from https://resend.com/api-keys
# Resend shows the value exactly once. Copy it straight into Vercel; do not
# route it through a chat window or an email to yourself.
# Without this the booking form returns a clear "not connected" error rather
# than silently dropping inquiries.
RESEND_API_KEY=

# Where booking inquiries are delivered.
INQUIRY_TO_EMAIL=steve@stevewelch.com

# The From address. Must be on a domain verified in Resend.
#
# Deliberately a SUBDOMAIN. Verifying the root stevewelch.com in Resend means
# putting its DNS records alongside the IONOS records that carry Steve's actual
# mail, and a mistake there breaks his inbox rather than a form. send. is
# isolated: worst case, the website stops sending and nothing personal moves.
#
# Both forms fail closed if this is unset — they answer 503 and show the direct
# address — so an unverified guess is never attempted.
INQUIRY_FROM_EMAIL=website@send.stevewelch.com

# Optional. Set this to any random string to switch on the delivery self-test
# at /api/health/email/?token=THAT_STRING — it reports whether the key works
# and whether the sending domain is verified, and with &send=1 puts a real
# test message in INQUIRY_TO_EMAIL. Leave it empty and the route 404s.
DIAG_TOKEN=

# ---------------------------------------------------------------------------
# Measurement. Names only here; values go in the Vercel project settings.
#
# These three are NOT secrets — a GA4 measurement ID and an Ads conversion
# label appear in the page source of every site that uses them, which is how
# the tag works at all. They are NEXT_PUBLIC_ deliberately.
#
# NEXT_PUBLIC_ variables are inlined at BUILD time, so adding or changing one
# does nothing until the project is redeployed. Setting the value and then
# wondering why nothing tracks is the usual way to lose an afternoon.
#
# The site works with none of these set: components/Analytics.tsx renders
# nothing at all and no script loads. Nothing to disable, nothing to break.
#
# IN VERCEL, SET THESE TO "CONFIG", NOT "SECRET". Vercel defaults new variables
# to Secret and then warns that a NEXT_PUBLIC_ prefix contradicts it — correctly,
# since the value is compiled into the JavaScript every visitor downloads. These
# three are meant to be public; a measurement ID that were somehow private would
# not function. RESEND_API_KEY above is the opposite case and must stay Secret.
#
# AND SET THEM ON PRODUCTION ONLY. Adding them to Preview or Development sends
# your own testing into the same property — every preview click, every form
# test. A campaign judged on a few dozen conversions is distorted badly by its
# owner's own traffic.
# ---------------------------------------------------------------------------

# GA4 measurement ID, from the Web stream details page. Format G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion ID. Format AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# The conversion LABEL for the "Booking Inquiry" action. Both halves are
# required — an ID without a label silently records nothing.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
